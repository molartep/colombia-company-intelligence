# Local commands use localhost. Compose overrides DATABASE_URL for its internal network.
DATABASE_URL=postgresql+asyncpg://cci:cci@localhost:5432/cci
POSTGRES_USER=cci
POSTGRES_PASSWORD=cci
POSTGRES_DB=cci
SOCRATA_APP_TOKEN=
# RUES network-phase deadline, including metadata and retries; maximum 60 seconds.
SOCRATA_TIMEOUT=60
SOCRATA_RETRIES=2
UPSTREAM_CONCURRENCY=4
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
# TEST_DATABASE_URL must point to a separate disposable database (tests delete its tables).
# TEST_DATABASE_URL=postgresql+asyncpg://cci:cci@localhost:5433/cci_test

# Issuer directory uses administrative imports. RNVE summaries and securities refresh on tab access.
CAPITAL_MARKETS_STORAGE_DIR=var/capital-markets
CAPITAL_MARKETS_MAX_AGE_HOURS=24
CAPITAL_MARKETS_TIMEOUT=30
CAPITAL_MARKETS_RETRIES=2

# BVC last-reported prices are cached separately; no real-time quote guarantee.
BVC_CACHE_MINUTES=15
# Optional administrator key for non-loopback directory imports (at least 32 characters).
# ADMIN_IMPORT_TOKEN=generate-a-strong-random-value
# Additional verified page locators, JSON ANN-code -> official BVC summary URL.
# BVC_PAGE_URLS={}

# Secondary quote page locators (default: supplied Ecopetrol page); URL slugs are not identity evidence.

# SECOP screening: successful-cache TTL and strict selective-query safety limits
SECOP_CACHE_HOURS=24
SECOP_MAX_ROWS=5000
SECOP_RUN_TIMEOUT=90

# Rae: disabled by default. Live company mode requires explicit processing authorization.
RAE_ENABLED=false
RAE_EXECUTION_MODE=disabled
# Set true only with authorization for minimized company evidence processing.
RAE_COMPANY_PROCESSING_AUTHORIZED=false
RAE_API_BASE_URL=https://enterprise-api.rainbird.ai
RAE_ENGINE=rbx
RAE_MODEL_REFERENCE_MODE=published_build
RAE_API_KEY=
RAE_EVIDENCE_KEY=
RAE_MODEL_ID=
# Wizard build IDs change on every publish. Set RAE_MODEL_ID from its connection guide.
# Legacy maps only: use RAE_MODEL_REFERENCE_MODE=version and an integer below.
# RAE_MODEL_VERSION=1
RAE_REQUEST_TIMEOUT_SECONDS=30
RAE_CACHE_HOURS=24
GOVERNMENT_INVOLVEMENT_LOOKBACK_MONTHS=24
