{
    email {$ACME_EMAIL}
    # Error logs must not include upstream URLs or query strings.
    log default {
        level ERROR
        format filter {
            wrap json
            fields {
                request delete
                uri delete
                headers delete
            }
        }
    }
}

{$PUBLIC_HOSTNAME} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
    # No access log: registry queries can identify natural persons.
    handle /api/* {
        reverse_proxy backend:8000 {
            # Replace client-supplied forwarding headers; DNS-only Cloudflare is required.
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up -Forwarded
        }
    }
    @private path /health /ready /docs /docs/* /redoc /openapi.json
    handle @private {
        respond 404
    }
    handle /assets/* {
        root * /srv
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
}
