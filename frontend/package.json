{
  "name": "colombia-company-intelligence-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src *.ts *.js *.json index.html",
    "format:check": "prettier --check src *.ts *.js *.json index.html"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "i18next": "^27.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.2.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
