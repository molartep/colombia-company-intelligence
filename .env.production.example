# Copy OUTSIDE the checkout to /etc/cci/production.env; chmod 600.
# Scripts load this with Docker Compose, not shell source.
PUBLIC_HOSTNAME=molartep.cci.com
ACME_EMAIL=replace-with-your-email@example.com
CCI_DATA_DIR=/srv/cci
CCI_BACKUP_DIR=/srv/cci-backups
RELEASE_TAG=initial
POSTGRES_USER=cci
POSTGRES_DB=cci
# Replace with: openssl rand -hex 32 (hex avoids URL/env interpolation ambiguity).
POSTGRES_PASSWORD=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SOCRATA_APP_TOKEN=
SOCRATA_TIMEOUT=60
UPSTREAM_CONCURRENCY=4
SEARCH_REQUESTS_PER_MINUTE=30
REFRESH_REQUESTS_PER_MINUTE=6
REFRESH_MIN_INTERVAL_SECONDS=60
RATE_LIMIT_MAX_ENTRIES=10000
CAPITAL_MARKETS_TIMEOUT=30
CAPITAL_MARKETS_RETRIES=2
CAPITAL_MARKETS_MAX_AGE_HOURS=24
BVC_CACHE_MINUTES=15
# Optional: enables administrator-only RNVE imports through the UI. Generate with openssl rand -hex 32.
# ADMIN_IMPORT_TOKEN=REPLACE_WITH_A_SEPARATE_GENERATED_SECRET
